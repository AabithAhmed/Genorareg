{
  "name": "candidate-pass-generator",
  "version": "1.0.0",
  "description": "Automated CSV to Personalized Pass and Email System",
  "scripts": {
    "dev": "concurrently \"python server-python/app.py\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "python server-python/app.py",
    "install:all": "npm install && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
